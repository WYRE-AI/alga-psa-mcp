# Standalone only. Gateway mode ignores all three credentials below.
ALGA_INSTANCE_URL=https://psa.example.com
ALGA_API_KEY=
ALGA_TENANT_ID=
# HTTP: gateway (default) or env. Uncomment only for standalone HTTP with the credentials above. Stdio always uses them.
# AUTH_MODE=env
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
# HTTP requires a real S2S secret of at least 32 characters. Generate: openssl rand -hex 32
CONDUIT_S2S_SECRET=
# MCP_HTTP_HOST=127.0.0.1
# Local development only; needs NODE_ENV=development, an empty S2S secret and loopback binding.
# MCP_ALLOW_INSECURE_DEV=1
# Every tool is read-only, so "read" is the only valid tier (and the default).
ALGA_TOOL_TIERS=read
# Sandbox only: allows HTTP and private networks; logs a loud startup warning.
# Stdio and AUTH_MODE=env only: HTTP refuses to start with it in AUTH_MODE=gateway.
ALGA_ALLOW_PRIVATE_INSTANCE=false
LOG_LEVEL=info
