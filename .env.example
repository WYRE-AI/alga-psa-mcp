# Standalone only. Gateway mode ignores all three credentials below.
ALGA_INSTANCE_URL=https://psa.example.com
ALGA_API_KEY=
ALGA_TENANT_ID=
AUTH_MODE=env
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
# HTTP requires a real S2S secret. Generate: openssl rand -hex 32
CONDUIT_S2S_SECRET=
# MCP_HTTP_HOST=127.0.0.1
# Local development only; empty S2S secret and loopback binding required.
# MCP_ALLOW_INSECURE_DEV=1
ALGA_ENABLE_DESTRUCTIVE=false
READ_ONLY_MODE=false
# Sandbox only: allows HTTP and private networks; logs a loud startup warning.
ALGA_ALLOW_PRIVATE_INSTANCE=false
LOG_LEVEL=info
